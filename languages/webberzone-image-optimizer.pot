#: includes/admin/class-settings.php:600
msgid "Keep working through the queue on a schedule even when the bulk screen is closed."
msgstr ""

#: includes/admin/class-settings.php:606
msgid "Queue images on first view"
msgstr ""

#: includes/admin/class-settings.php:607
msgid "Queue an unconverted image the first time a page references it, serving the original meanwhile. Nothing is ever encoded during a page render."
msgstr ""

#: includes/admin/class-settings.php:613
msgid "Exclude paths"
msgstr ""

#: includes/admin/class-settings.php:614
msgid "One fragment per line, for example 2019/07 or /logos/. Matching paths inside the uploads folder are left alone."
msgstr ""

#: includes/admin/class-settings.php:620
msgid "Delete optimized files on uninstall"
msgstr ""

#: includes/admin/class-settings.php:621
